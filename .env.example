# ============================================
# MAMNON2 - CẤU HÌNH CHO TRƯỜNG MỚI
# ============================================
# Copy file này thành .env và chỉnh sửa theo nhu cầu
#
# HƯỚNG DẪN:
# 1. cp .env.example .env
# 2. Sửa các giá trị bên dưới
# 3. Chạy: npm install && npm run dev
#
# Sau khi chạy, vào http://localhost:3000/admin
# để chỉnh sửa TÊN, LOGO, MÀU trường trong mục Schools
# ============================================

# --- SERVER ---
PORT=3000

# --- DATABASE MONGODB ---
# ⚠️ THAY ĐỔI tên database theo tên trường!
# Ví dụ:
#   - Trường X: mamnon2-xuan-diep / mamnon2-xuan-diep-session
#   - Trường Y: mamnon2-ngoc-hoang / mamnon2-ngoc-hoang-session
MONGO_URL=mongodb://localhost:27017/mamnon2-TEN_TRUONG
MONGO_URL_SESSION=mongodb://localhost:27017/mamnon2-TEN_TRUONG-session
MONGO_USER=
MONGO_PASS=
MONGO_AUTH_SOURCE=admin

# --- BẢO MẬT ---
# ⚠️ BẮT BUỘC đổi giá trị này trước khi deploy production!
COOKIE_SECRET=CHANGE_ME_PLEASE_USE_SOMETHING_RANDOM_HERE

# --- APP DEFAULTS (có thể override trong Admin > Schools) ---
# APP_TITLE=Camera Mầm Non
# APP_COLOR=#ff6b6b
# APP_LOGO=/images/student.png
