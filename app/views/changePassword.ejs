<div class="text-center">
    <div class="login-header">
        <h1>ĐỔI MẬT KHẨU</h1>
        <p>Mật khẩu của bạn đang là mặc định, hãy đổi mật khẩu mới để bảo mật hơn nhé! 🔐</p>
    </div>
</div>

<div class="mt-4">
    <div class="form-group mb-4">
        <label for="new_pwd">Mật khẩu mới</label>
        <input type="text" class="form-control" id="new_pwd"
            placeholder="Nhập ít nhất 8 ký tự"
            v-model="pwdchange"
        >
    </div>

    <div v-if="pwdchange.length > 0 && pwdchange.length < 8" class="status-msg alert-danger">
        Mật khẩu cần ít nhất 8 ký tự bạn nhé!
    </div>
    
    <div v-if="pwdchange.length >= 8" class="status-msg alert-success">
        Mật khẩu này hợp lệ rồi nè! ✨
    </div>

    <button 
        class="btn-login" 
        :disabled="pwdchange.length < 8"
        :style="pwdchange.length < 8 ? 'opacity: 0.5; cursor: not-allowed;' : ''"
        @click="changePassword"
    >
        Cập nhật mật khẩu
    </button>
</div>
