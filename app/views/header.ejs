<style>
  body {
    background-color: #f8f9fa;
    font-family: 'Nunito', sans-serif;
  }
  .mn-container {
    padding: 24px 12px;
  }
  .mn-card {
    background: #fff;
    border: 1px solid #f0f0f0;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    padding: 22px 18px;
  }
  .mn-title {
    color: #ff6b6b;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .mn-subtitle {
    color: #666;
    font-weight: 600;
  }
  .navbar {
    background: #fff !important;
    border-bottom: 1px solid #f2f2f2;
    box-shadow: 0 6px 20px rgba(0,0,0,0.06);
  }
  .navbar-brand {
    color: #ff6b6b !important;
    font-weight: 800;
  }
  .nav-link {
    color: #555 !important;
    font-weight: 700;
  }
  .navbar-toggler {
    border-radius: 12px;
    border-color: #eee;
  }
  .mn-toast-container {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 18px;
    z-index: 1000001;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
  }
  .mn-toast {
    background: #fff;
    border-radius: 18px;
    padding: 12px 14px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.18);
    border-left: 6px solid #4ecdc4;
    color: #333;
    font-weight: 800;
    font-size: 13px;
    pointer-events: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .mn-toast.show {
    opacity: 1;
    transform: translateY(0);
  }
  .mn-toast.info { border-left-color: #4ecdc4; }
  .mn-toast.success { border-left-color: #22c55e; }
  .mn-toast.warning { border-left-color: #f59e0b; }
  .mn-toast.danger { border-left-color: #ff6b6b; }
</style>
<script>
  (function () {
    function ensureContainer() {
      var el = document.getElementById('mn-toast-container')
      if (el) return el
      el = document.createElement('div')
      el.id = 'mn-toast-container'
      el.className = 'mn-toast-container'
      document.body.appendChild(el)
      return el
    }

    window.mnToast = function (message, variant, timeoutMs) {
      try {
        var container = ensureContainer()
        var toast = document.createElement('div')
        toast.className = 'mn-toast ' + (variant || 'info')
        toast.textContent = message || ''
        container.appendChild(toast)
        setTimeout(function () { toast.classList.add('show') }, 10)
        var ttl = typeof timeoutMs === 'number' ? timeoutMs : 2200
        setTimeout(function () {
          toast.classList.remove('show')
          setTimeout(function () {
            if (toast && toast.parentNode) toast.parentNode.removeChild(toast)
          }, 220)
        }, ttl)
      } catch (e) {
        alert(message)
      }
    }
  })()
</script>
<script>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
                .then(reg => console.log('SW registered!', reg))
                .catch(err => console.log('SW registration failed!', err));
        });
    }
</script>
