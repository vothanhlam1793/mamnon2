<% if(title == undefined) {var title = "Chua dat tieu de"} %>
<title><%= title %></title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<link rel="icon" href="images/student.png" type = "image/x-icon">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#ff6b6b">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Mầm Non">
<link rel="apple-touch-icon" href="images/student.png">

<link rel="stylesheet" href="/cdn/bootstrap.min.css">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">

<script src="/cdn/jquery.min.js"></script>
<script src="/cdn/popper.min.js"></script>
<script src="/cdn/bootstrap.min.js"></script>
<script src="/cdn/jquery_2.min.js"></script>
<script src="/cdn/vue.js"></script>
<script src="js/graphql.js"></script>
<script src="/cdn/vuex.js"></script>
<style>
  body {
    background-color: #f8f9fa;
    font-family: 'Nunito', sans-serif;
  }
  .mn-container {
    padding: 24px 12px;
  }
  .mn-card {
    background: #fff;
    border: 1px solid #f0f0f0;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    padding: 22px 18px;
  }
  .mn-title {
    color: #ff6b6b;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .mn-subtitle {
    color: #666;
    font-weight: 600;
  }
  .navbar {
    background: #fff !important;
    border-bottom: 1px solid #f2f2f2;
    box-shadow: 0 6px 20px rgba(0,0,0,0.06);
  }
  .navbar-brand {
    color: #ff6b6b !important;
    font-weight: 800;
  }
  .nav-link {
    color: #555 !important;
    font-weight: 700;
  }
  .navbar-toggler {
    border-radius: 12px;
    border-color: #eee;
  }
</style>
<script>
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
                .then(reg => console.log('SW registered!', reg))
                .catch(err => console.log('SW registration failed!', err));
        });
    }
</script>
