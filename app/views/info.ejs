<html>
    <head>
        <%- include("header.ejs", {"title": "Kỹ thuật"}) %>
    </head>
    <body>
        <%- include("menu.ejs"); %>
        <div class="container mn-container">
            <div class="mn-card">
                <h2 class="mn-title">Hỗ trợ khách hàng</h2>
                <p class="mn-subtitle">Khi gặp sự cố đăng nhập hoặc cần hỗ trợ, vui lòng liên hệ qua các kênh sau.</p>
                <div class="mt-4">
                    <% if (setting) { %>
                        <div class="mb-3">
                            <div class="font-weight-bold mb-2">Gọi điện trực tiếp</div>
                            <a href="tel:<%= setting.hotline %>" class="btn btn-success btn-block" style="border-radius: 14px; font-weight: 800;">Gọi <%= setting.hotline %></a>
                        </div>
                        <div class="mb-3">
                            <div class="font-weight-bold mb-2">Liên lạc qua Zalo</div>
                            <a href="https://chat.zalo.me/?phone=<%= setting.zaloId %>" class="btn btn-primary btn-block" style="border-radius: 14px; font-weight: 800;">Zalo: <%= setting.zaloId %></a>
                        </div>
                        <div class="mb-3">
                            <div class="font-weight-bold">Người liên hệ</div>
                            <div><strong><%= setting.contactName %></strong></div>
                        </div>

                        <% if (setting.workDays || setting.workTime) { %>
                            <div class="mb-2 font-weight-bold">Thời gian làm việc</div>
                            <div class="mb-2"><%= setting.workDays || 'Thứ 2 - thứ 6' %></div>
                            <ul class="mb-0">
                                <% if (setting.workTime) { %>
                                    <li>Sáng: <%= setting.workTime.split('/')[0] %></li>
                                    <li>Chiều: <%= setting.workTime.split('/')[1] || setting.workTime %></li>
                                <% } else { %>
                                    <li>Sáng: 8g - 11g30</li>
                                    <li>Chiều: 13g30 - 17g30</li>
                                <% } %>
                            </ul>
                        <% } %>
                    <% } else { %>
                        <div class="alert alert-warning" style="border-radius: 16px;">Hệ thống chưa có thông tin liên hệ. Vui lòng liên hệ quản trị viên.</div>
                    <% } %>
                </div>
            </div>
        </div>
        
        <script>
        (function() {
            var ua = navigator.userAgent.toLowerCase();
            if (ua.includes('zalo') || ua.includes('zaloapp')) {
                var currentUrl = window.location.href;
                window.location.href = 'intent://' + currentUrl.replace(/^https?:\/\//, '') + '#Intent;scheme=https;package=com.zing.zalo;end';
            }
        })();
        </script>
    </body>
</html>
